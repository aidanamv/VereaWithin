# Copy this file to ".env" and fill in real values.
# All values are optional — the API works without email/admin configured,
# it just skips sending emails and locks the /api/admin/* endpoints.

# --- Database (defaults to local SQLite file verea.db) ---
# DATABASE_URL=sqlite:///verea.db

# --- Outgoing email (SMTP) — using Gmail ---
# 1. Enable 2-Step Verification on verea.within@gmail.com
# 2. Create an "App Password" at https://myaccount.google.com/apppasswords
# 3. Paste that 16-character app password below as SMTP_PASS (NOT the normal
#    Gmail login password — Google blocks that for SMTP).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=verea.within@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
FROM_EMAIL=verea.within@gmail.com
NOTIFY_EMAIL=verea.within@gmail.com

# --- Admin API key (required header "X-Admin-Key" to view /api/admin/*) ---
ADMIN_API_KEY=change-me-to-a-long-random-string

# --- Server ---
PORT=5000
FLASK_DEBUG=1

